# Isolated claude-code agent (parallels sdebench-agent for opencode). Auth (ANTHROPIC_API_KEY or a
# mounted ~/.claude/.credentials.json) is provided at runtime — none baked in.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
RUN npm i -g @anthropic-ai/claude-code
# Memory is injected by the HARNESS via --append-system-prompt (a TRUSTED channel). We do NOT use a
# UserPromptSubmit hook: claude treats hook-injected additionalContext as a possible prompt-injection
# and REFUSES it (validated). So no hook is registered — the harness reflects and appends to the system
# prompt instead. Auth (OAuth creds) is mounted at runtime.
WORKDIR /work
