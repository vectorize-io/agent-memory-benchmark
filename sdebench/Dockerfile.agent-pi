# Isolated pi coding agent (parallels sdebench-agent-claude). Auth (pi's ~/.pi/agent/auth.json — e.g.
# an OpenAI Codex subscription login) is mounted at runtime; none baked in. pi runs its tools without
# a permission prompt in print mode, so no allow-list is needed. Memory arrives through the plugin's
# own installer (`install pi`), run by the harness at container start.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
RUN npm i -g @earendil-works/pi-coding-agent@1.0.0
WORKDIR /work
